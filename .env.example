# Copy to .env for local live-ingestion runs. Never commit a real .env.
# This project only READS public blockchain data. No private key or signing
# credential is ever required or accepted.

# Base mainnet public RPC endpoint (see docs/DATA_SOURCE.md for verification
# and rate-limit notes). Override with a provider URL (Alchemy/QuickNode/etc.)
# for anything beyond a small demo range.
BASE_RPC_URL=https://mainnet.base.org

# Optional: use Base Sepolia testnet instead of mainnet for dry runs.
# BASE_RPC_URL=https://sepolia.base.org

# Block range fetched per eth_getLogs call. Kept conservative because the
# public Base RPC's documented/observed cap is reported between 2,000 and
# 10,000 blocks depending on load; see docs/DATA_SOURCE.md.
EVENTSTREAM_BLOCK_CHUNK_SIZE=2000
