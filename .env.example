# Copy to .env for local live-ingestion runs. Never commit a real .env.
# This project only READS public blockchain data. No private key or signing
# credential is ever required or accepted.

# Base mainnet public RPC endpoint (see docs/DATA_SOURCE.md for verification
# and rate-limit notes). Override with a provider URL (Alchemy/QuickNode/etc.)
# for anything beyond a small demo range.
BASE_RPC_URL=https://mainnet.base.org

# Optional: use Base Sepolia testnet instead of mainnet for dry runs.
# BASE_RPC_URL=https://sepolia.base.org

# Upper bound on the block range fetched per eth_getLogs call. mainnet.base.org
# rejects spans over 2,000 blocks, and separately rejects responses over roughly
# 20,000 logs, so the client starts small and adapts within this ceiling; see
# docs/DATA_SOURCE.md.
EVENTSTREAM_BLOCK_CHUNK_SIZE=2000

# Optional: keep a real-data warehouse apart from the fixture-based one that
# `eventstream demo` rebuilds (and would otherwise overwrite).
# EVENTSTREAM_WAREHOUSE_PATH=data/processed/base_usdc_real.duckdb

# Optional: cap DuckDB's memory and threads when the machine has little FREE RAM. DuckDB's default
# limit is 80% of installed memory, which can exceed what is actually free and makes large steps
# lean on OS paging instead of spilling to disk. The real-data window in the README was built with
# a 4GB cap on a 16GB laptop.
# EVENTSTREAM_DUCKDB_MEMORY_LIMIT=4GB
# EVENTSTREAM_DUCKDB_THREADS=8
